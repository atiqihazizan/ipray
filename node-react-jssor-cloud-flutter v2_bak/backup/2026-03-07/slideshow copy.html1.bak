<div class="config-group">
	<h3 class="config-group-title">Tetapan Slideshow</h3>
	<div class="config-group-items">
		<div class="config-item">
			<label for="SLIDESHOW_SHUFFLE">Kacau Susunan Setiap Kitaran</label>
			<div class="config-item-control">
				<input type="checkbox" id="SLIDESHOW_SHUFFLE" name="SLIDESHOW_SHUFFLE" />
				<button type="button" class="btn-icon btn-edit" onclick="saveConfigItem('SLIDESHOW_SHUFFLE')" title="Simpan">
					<span><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" /></svg></span>
				</button>
			</div>
		</div>
	</div>
</div>
