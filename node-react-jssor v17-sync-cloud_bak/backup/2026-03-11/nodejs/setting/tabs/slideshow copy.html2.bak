<div class="content-card">
	<nav id="slideshow-subnav" class="config-subnav">
		<button type="button" class="config-subtab active" data-slideshow-tab="senarai" onclick="showSlideshowTab('senarai')">Senarai Slideshow</button>
		<button type="button" class="config-subtab" data-slideshow-tab="setting" onclick="showSlideshowTab('setting')">Setting Paparan</button>
	</nav>

	<!-- Panel: Senarai Slideshow -->
	<div id="slideshow-panel-senarai" class="slideshow-panel" style="flex:1;display:flex;flex-direction:column;min-height:0;">
		<div class="flex justify-between items-center gap-2 mb-3" style="flex-shrink: 0;">
			<button type="button" class="btn-icon btn-chevron-back" onclick="showTab('slides')" title="Kembali ke Template">
				<span><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5" /></svg></span>
			</button>
			<div class="flex gap-2">
				<button class="btn-icon btn-add" onclick="openAddDialog()" title="Tambah Slideshow">
					<span><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" /></svg></span>
				</button>
				<button class="btn-icon btn-reload" onclick="loadTable('slideshow')" title="Muat Semula">
					<span><svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
						<path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
					</svg></span>
				</button>
			</div>
		</div>
		<div class="table-container">
			<table id="slideshow-table" class="data-table">
				<thead id="slideshow-thead"></thead>
				<tbody id="slideshow-tbody"></tbody>
			</table>
		</div>
	</div>

	<!-- Panel: Setting Paparan -->
	<div id="slideshow-panel-setting" class="slideshow-panel" style="display:none;flex:1;flex-direction:column;min-height:0;">
		<div style="margin-top:10px;margin-bottom:12px;">
			<p style="margin:0 0 8px;font-size:13px;color:#4b5563;line-height:1.6;">
				<strong>Setting Paparan</strong> mengawal overlay teks di atas paparan slideshow utama.
				Setiap perubahan akan disimpan <strong>serta-merta</strong> tanpa dialog.
			</p>
		</div>
		<div class="content-section" style="max-width:520px;">
			<div class="form-group">
				<label style="display:block;font-size:13px;font-weight:600;color:#374151;margin-bottom:6px;">Paparan overlay</label>
				<div id="slideshow-setting-paparan-group" style="display:flex;flex-direction:column;gap:8px;padding:10px 12px;border:1px solid #e5e7eb;border-radius:10px;background:#f9fafb;">
					<label style="display:inline-flex;align-items:center;gap:8px;font-size:13px;color:#374151;cursor:pointer;user-select:none;">
						<input type="checkbox" id="slideshow-setting-date" />
						<span>Tarikh (kalendar)</span>
					</label>
					<label style="display:inline-flex;align-items:center;gap:8px;font-size:13px;color:#374151;cursor:pointer;user-select:none;">
						<input type="checkbox" id="slideshow-setting-solat-time" />
						<span>Waktu solat (paparan utama)</span>
					</label>
					<label style="display:inline-flex;align-items:center;gap:8px;font-size:13px;color:#374151;cursor:pointer;user-select:none;">
						<input type="checkbox" id="slideshow-setting-solat-time-small" />
						<span>Waktu solat saiz kecil</span>
					</label>
				</div>
				<div id="slideshow-setting-status" style="margin-top:8px;font-size:12px;color:#6b7280;min-height:16px;">
					Sila tunggu, memuat setting paparan...
				</div>
			</div>
		</div>
	</div>
</div>
