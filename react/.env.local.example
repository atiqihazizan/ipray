# Salin fail ni ke ".env.local" (fail sebenar, digitignore) untuk arahkan dev server
# React ke backend lain (contoh: RPi produksi) tanpa ubah kod sumber.
#
# Cara guna:
#   1. cp .env.local.example .env.local
#   2. Tukar nilai IP/host/port di bawah ikut server yang hendak disambung
#   3. Restart dev server React (npm run dev) — env var hanya dibaca semasa start
#
# Nak kembali ke backend nodejs LOCAL (localhost:3001):
#   - Padam atau kosongkan .env.local terus (bukan fail .example ni)
#
# PENTING sebelum build produksi (npm run build):
#   - Pastikan .env.local TIADA atau KOSONG dulu — Vite baca fail ni semasa build juga,
#     jadi kalau wujud, IP/host ujian akan ter-bakar terus dalam bundle produksi.

VITE_API_BASE=http://100.108.32.65:3001
VITE_SOCKET_URL=http://100.108.32.65:3001
