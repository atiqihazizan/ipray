import 'package:flutter/material.dart';

import '../config/app_config.dart';
import '../widgets/panel_menu_grid.dart';
import 'cloud_panel_screen.dart';

/// Skrin menu grid pertama selepas login.
class CloudMenuScreen extends StatelessWidget {
  const CloudMenuScreen({
    super.key,
    required this.config,
  });

  final AppConfig config;

  void _openPanel(BuildContext context, String tabId, String title) {
    Navigator.of(context).push(
      MaterialPageRoute(
        builder: (context) => CloudPanelScreen(
          config: config,
          onConfigSaved: (_) {},
          initialTabId: tabId,
          initialTitle: title,
        ),
      ),
    );
  }

  /// Buka LoginScreen, reconnect socket dengan config baru selepas save.
  Future<void> _openConfig() async {
    await Navigator.of(context).push<void>(
      MaterialPageRoute(
        builder: (context) => LoginScreen(
          initialConfig: widget.config,
          onSaved: (newConfig) {
            _cloudSocket?.updateConfig(newConfig);
            widget.onConfigSaved(newConfig);
            Navigator.of(context).pop();
          },
          onReconnect: () {
            _cloudSocket?.reconnect();
            _cloudSocket?.onReadyStream.first.then((_) {
              if (mounted) _reloadPanelTab();
            });
          },
        ),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Muslim Indoor Digital Media'),
        backgroundColor: Theme.of(context).colorScheme.inversePrimary,
        actions: [
          IconButton(
            icon: const Icon(Icons.settings),
            onPressed: _openConfig,
            tooltip: 'Tetapan',
          ),
        ],
      ),
      body: PanelMenuGrid(
        onItemSelected: (tabId, title) => _openPanel(context, tabId, title),
      ),
    );
  }
}

