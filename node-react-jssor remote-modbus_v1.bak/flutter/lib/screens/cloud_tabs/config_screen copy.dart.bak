import 'package:flutter/material.dart';

/// Item tab dalam senarai konfigurasi (layer list tab).
class _ConfigTabItem {
  const _ConfigTabItem({
    required this.id,
    required this.title,
    required this.subtitle,
    required this.icon,
  });
  final String id;
  final String title;
  final String subtitle;
  final IconData icon;
}

/// Sub-skrin Konfigurasi: dua layer — list tab (senarai kiri) dan panel tab (kandungan kanan).
class ConfigScreen extends StatefulWidget {
  const ConfigScreen({super.key});

  @override
  State<ConfigScreen> createState() => _ConfigScreenState();
}

class _ConfigScreenState extends State<ConfigScreen> {
  static const List<_ConfigTabItem> _tabs = [
    _ConfigTabItem(id: 'title-home', title: 'Paparan Home', subtitle: 'Tajuk & gaya skrin utama', icon: Icons.home_rounded),
    _ConfigTabItem(id: 'waktu-solat', title: 'Waktu Solat', subtitle: 'Konfigurasi jadual solat harian', icon: Icons.access_time_rounded),
    _ConfigTabItem(id: 'slides', title: 'Paparan', subtitle: 'Template & layout paparan skrin', icon: Icons.dashboard_rounded),
    _ConfigTabItem(id: 'hebahan', title: 'Hebahan', subtitle: 'Teks hebahan untuk paparan', icon: Icons.campaign_rounded),
    _ConfigTabItem(id: 'takwim', title: 'Takwim', subtitle: 'Zon & takwim solat', icon: Icons.calendar_today_rounded),
    _ConfigTabItem(id: 'masa-sistem', title: 'Masa Sistem', subtitle: 'Tetapan tarikh & masa peranti', icon: Icons.schedule_rounded),
    _ConfigTabItem(id: 'wifi', title: 'Wi-Fi', subtitle: 'Sambungan rangkaian Wi-Fi', icon: Icons.wifi_rounded),
    _ConfigTabItem(id: 'hotspot', title: 'Hotspot', subtitle: 'Tetapan hotspot peranti', icon: Icons.satellite_alt_rounded),
    _ConfigTabItem(id: 'system', title: 'Sistem', subtitle: 'Tetapan lanjutan & sistem', icon: Icons.settings_rounded),
  ];

  String? _selectedTabId;

  @override
  Widget build(BuildContext context) {
    final isNarrow = MediaQuery.sizeOf(context).width < 600;
    return Container(
      color: const Color(0xFFF5F5F5),
      child: isNarrow ? _buildNarrowLayout() : _buildWideLayout(),
    );
  }

  Widget _buildNarrowLayout() {
    if (_selectedTabId != null) {
      return _ConfigPanelTabLayer(
        selectedTabId: _selectedTabId!,
        selectedTitle: _tabs.firstWhere((t) => t.id == _selectedTabId, orElse: () => _tabs.first).title,
        onBack: () => setState(() => _selectedTabId = null),
      );
    }
    return _ConfigListTabLayer(
      tabs: _tabs,
      selectedTabId: _selectedTabId,
      onTap: (id) => setState(() => _selectedTabId = id),
    );
  }

  Widget _buildWideLayout() {
    return Row(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        SizedBox(
          width: 320,
          child: _ConfigListTabLayer(
            tabs: _tabs,
            selectedTabId: _selectedTabId,
            onTap: (id) => setState(() => _selectedTabId = id),
          ),
        ),
        Expanded(
          child: _selectedTabId == null
              ? _buildEmptyPanel()
              : _ConfigPanelTabLayer(
                  selectedTabId: _selectedTabId!,
                  selectedTitle: _tabs.firstWhere((t) => t.id == _selectedTabId).title,
                  onBack: () => setState(() => _selectedTabId = null),
                ),
        ),
      ],
    );
  }

  Widget _buildEmptyPanel() {
    return Center(
      child: Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          Icon(Icons.touch_app_rounded, size: 48, color: Colors.grey.shade400),
          const SizedBox(height: 12),
          Text(
            'Pilih tetapan di sebelah kiri',
            style: TextStyle(color: Colors.grey.shade600, fontSize: 14),
          ),
        ],
      ),
    );
  }
}

// ─── Layer 1: List tab (gaya image 1) ─────────────────────────────────────
/// Senarai tab konfigurasi: ikon dalam bulatan, tajuk, sub-tajuk, chevron.
class _ConfigListTabLayer extends StatelessWidget {
  const _ConfigListTabLayer({
    required this.tabs,
    required this.selectedTabId,
    required this.onTap,
  });

  final List<_ConfigTabItem> tabs;
  final String? selectedTabId;
  final void Function(String) onTap;

  @override
  Widget build(BuildContext context) {
    return SingleChildScrollView(
      padding: const EdgeInsets.all(16),
      child: Material(
        color: Colors.white,
        borderRadius: BorderRadius.circular(12),
        elevation: 1,
        shadowColor: Colors.black.withOpacity(0.06),
        child: ClipRRect(
          borderRadius: BorderRadius.circular(12),
          child: Column(
            mainAxisSize: MainAxisSize.min,
            children: List.generate(tabs.length * 2 - 1, (i) {
              if (i.isOdd) {
                return Divider(height: 1, thickness: 1, color: Colors.grey.shade200);
              }
              final tab = tabs[i ~/ 2];
              final isSelected = selectedTabId == tab.id;
              return InkWell(
                onTap: () => onTap(tab.id),
                child: Container(
                  color: isSelected ? const Color(0xFFEEF2FF) : null,
                  padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 12),
                  child: Row(
                    children: [
                      Container(
                        width: 40,
                        height: 40,
                        decoration: BoxDecoration(
                          color: const Color(0xFFF0F0F0),
                          shape: BoxShape.circle,
                        ),
                        child: Icon(tab.icon, size: 22, color: _iconColor(tab.id)),
                      ),
                      const SizedBox(width: 12),
                      Expanded(
                        child: Column(
                          crossAxisAlignment: CrossAxisAlignment.start,
                          mainAxisSize: MainAxisSize.min,
                          children: [
                            Text(
                              tab.title,
                              style: const TextStyle(
                                fontSize: 16,
                                fontWeight: FontWeight.w600,
                                color: Color(0xFF333333),
                              ),
                            ),
                            const SizedBox(height: 2),
                            Text(
                              tab.subtitle,
                              style: TextStyle(
                                fontSize: 13,
                                color: Colors.grey.shade600,
                              ),
                              maxLines: 1,
                              overflow: TextOverflow.ellipsis,
                            ),
                          ],
                        ),
                      ),
                      Icon(Icons.chevron_right, size: 24, color: Colors.grey.shade500),
                    ],
                  ),
                ),
              );
            }),
          ),
        ),
      ),
    );
  }

  Color _iconColor(String id) {
    switch (id) {
      case 'title-home':
        return const Color(0xFFE53935);
      case 'waktu-solat':
        return const Color(0xFF1976D2);
      case 'slides':
        return const Color(0xFF43A047);
      case 'hebahan':
        return const Color(0xFFFB8C00);
      case 'takwim':
        return const Color(0xFFE53935);
      case 'wifi':
        return const Color(0xFF2196F3);
      default:
        return const Color(0xFF666666);
    }
  }
}

// ─── Layer 2: Panel tab (gaya image 2) ─────────────────────────────────────
/// Panel kandungan: butang Kembali, tajuk bahagian (ALL CAPS), kad putih dengan baris tetapan.
class _ConfigPanelTabLayer extends StatelessWidget {
  const _ConfigPanelTabLayer({
    required this.selectedTabId,
    required this.selectedTitle,
    required this.onBack,
  });

  final String selectedTabId;
  final String selectedTitle;
  final VoidCallback onBack;

  @override
  Widget build(BuildContext context) {
    return Column(
      crossAxisAlignment: CrossAxisAlignment.stretch,
      children: [
        Padding(
          padding: const EdgeInsets.fromLTRB(16, 8, 16, 12),
          child: Row(
            children: [
              Material(
                color: const Color(0xFFF1F5F9),
                borderRadius: BorderRadius.circular(8),
                child: InkWell(
                  onTap: onBack,
                  borderRadius: BorderRadius.circular(8),
                  child: Padding(
                    padding: const EdgeInsets.symmetric(horizontal: 12, vertical: 8),
                    child: Row(
                      mainAxisSize: MainAxisSize.min,
                      children: [
                        Icon(Icons.arrow_back, size: 18, color: Colors.grey.shade700),
                        const SizedBox(width: 6),
                        Text('Kembali', style: TextStyle(fontSize: 14, fontWeight: FontWeight.w500, color: Colors.grey.shade800)),
                      ],
                    ),
                  ),
                ),
              ),
            ],
          ),
        ),
        Expanded(
          child: ListView(
            padding: const EdgeInsets.fromLTRB(16, 0, 16, 24),
            children: _buildPanelContent(),
          ),
        ),
      ],
    );
  }

  List<Widget> _buildPanelContent() {
    if (selectedTabId == 'title-home') {
      return _buildTitleHomePanel();
    }
    return [
      _sectionHeader('KANDUNGAN'),
      _configCard(children: [
        _configRowLabel('Tetapan untuk "$selectedTitle" akan dipaparkan di sini.'),
      ]),
    ];
  }

  List<Widget> _buildTitleHomePanel() {
    return [
      _sectionHeader('PAPARAN TAJUK HOME'),
      _configCard(children: [
        _configRowToggle('Tajuk Home', false),
        _configRowInput('Tempoh Paparan (saat)', '1', 's'),
      ]),
      const SizedBox(height: 20),
      _sectionHeader('PAPARAN TEKS SKRIN UTAMA - KOTAK TEKS'),
      _configCard(children: [
        _configRowInput('Posisi Atas (px)', '480', 'px'),
        _configRowInput('Posisi Kiri (px)', '28', 'px'),
        _configRowInput('Posisi Kanan (px)', '0', 'px'),
        _configRowInput('Gap Teks (px)', '30', 'px'),
        _configRowDropdown('Penjajaran', 'Tengah', ['Kiri', 'Tengah', 'Kanan']),
      ]),
      const SizedBox(height: 20),
      _sectionHeader('PAPARAN TEKS SKRIN UTAMA - TEKS PERTAMA'),
      _configCard(children: [
        _configRowInput('Saiz Font (px)', '68', 'px'),
        _configRowColor('Warna Teks', const Color(0xFF00FFFF), '#00ffff'),
      ]),
      const SizedBox(height: 20),
      _sectionHeader('PAPARAN TEKS SKRIN UTAMA - TEKS KEDUA'),
      _configCard(children: [
        _configRowInput('Saiz Font (px)', '68', 'px'),
        _configRowColor('Warna Teks', const Color(0xFF00FFFF), '#00ffff'),
      ]),
    ];
  }

  Widget _sectionHeader(String title) {
    return Padding(
      padding: const EdgeInsets.fromLTRB(0, 12, 0, 6),
      child: Text(
        title,
        style: const TextStyle(
          fontSize: 10,
          fontWeight: FontWeight.w600,
          letterSpacing: 0.04,
          color: Color(0xFF6B7280),
        ),
      ),
    );
  }

  Widget _configCard({required List<Widget> children}) {
    return Material(
      color: Colors.white,
      borderRadius: BorderRadius.circular(12),
      elevation: 1,
      shadowColor: Colors.black.withOpacity(0.06),
      child: Padding(
        padding: const EdgeInsets.symmetric(vertical: 4),
        child: Column(
          children: List.generate(children.length * 2 - 1, (i) {
            if (i.isOdd) {
              return Divider(height: 1, thickness: 1, color: Colors.grey.shade100);
            }
            return Padding(
              padding: const EdgeInsets.symmetric(horizontal: 16, vertical: 10),
              child: children[i ~/ 2],
            );
          }),
        ),
      ),
    );
  }

  Widget _configRowLabel(String label) {
    return Row(
      children: [
        Text(label, style: TextStyle(fontSize: 12, fontWeight: FontWeight.w500, color: Colors.grey.shade700)),
      ],
    );
  }

  Widget _configRowToggle(String label, bool value) {
    return Row(
      mainAxisAlignment: MainAxisAlignment.spaceBetween,
      children: [
        Text(label, style: const TextStyle(fontSize: 12, fontWeight: FontWeight.w500, color: Color(0xFF374151))),
        Switch(value: value, onChanged: (_) {}),
      ],
    );
  }

  Widget _configRowInput(String label, String value, String unit) {
    return Row(
      mainAxisAlignment: MainAxisAlignment.spaceBetween,
      children: [
        Text(label, style: const TextStyle(fontSize: 12, fontWeight: FontWeight.w500, color: Color(0xFF374151))),
        Row(
          mainAxisSize: MainAxisSize.min,
          children: [
            SizedBox(
              width: 64,
              child: TextField(
                controller: TextEditingController(text: value),
                decoration: const InputDecoration(
                  isDense: true,
                  contentPadding: EdgeInsets.symmetric(horizontal: 6, vertical: 6),
                  border: UnderlineInputBorder(),
                  focusedBorder: UnderlineInputBorder(borderSide: BorderSide(color: Color(0xFF6366F1))),
                ),
                style: const TextStyle(fontSize: 12),
                textAlign: TextAlign.right,
              ),
            ),
            const SizedBox(width: 4),
            Text(unit, style: TextStyle(fontSize: 11, color: Colors.grey.shade600)),
          ],
        ),
      ],
    );
  }

  Widget _configRowDropdown(String label, String value, List<String> options) {
    return Row(
      mainAxisAlignment: MainAxisAlignment.spaceBetween,
      children: [
        Text(label, style: const TextStyle(fontSize: 12, fontWeight: FontWeight.w500, color: Color(0xFF374151))),
        DropdownButton<String>(
          value: value,
          isDense: true,
          underline: const SizedBox(),
          items: options.map((o) => DropdownMenuItem(value: o, child: Text(o, style: const TextStyle(fontSize: 12)))).toList(),
          onChanged: (_) {},
        ),
      ],
    );
  }

  Widget _configRowColor(String label, Color color, String hex) {
    return Row(
      mainAxisAlignment: MainAxisAlignment.spaceBetween,
      children: [
        Text(label, style: const TextStyle(fontSize: 12, fontWeight: FontWeight.w500, color: Color(0xFF374151))),
        Row(
          mainAxisSize: MainAxisSize.min,
          children: [
            Container(
              width: 28,
              height: 24,
              decoration: BoxDecoration(
                color: color,
                border: Border.all(color: Colors.grey.shade300),
                borderRadius: BorderRadius.zero,
              ),
            ),
            const SizedBox(width: 8),
            SizedBox(
              width: 72,
              child: TextField(
                controller: TextEditingController(text: hex),
                decoration: const InputDecoration(
                  isDense: true,
                  contentPadding: EdgeInsets.symmetric(horizontal: 6, vertical: 6),
                  border: UnderlineInputBorder(),
                  focusedBorder: UnderlineInputBorder(borderSide: BorderSide(color: Color(0xFF6366F1))),
                ),
                style: const TextStyle(fontSize: 12),
              ),
            ),
          ],
        ),
      ],
    );
  }
}
